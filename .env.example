# defi-investor — Supabase credentials
# Copy to `.env` and fill in real values. `.env` is gitignored.
# The scraper falls back to file-only mode (NoOpWriter) if either is unset.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# GitHub PAT for scripted push / backup (optional; gh CLI keyring auth also works)
GITHUB_TOKEN=github_pat_...
