# Reference books (copyrighted PDFs, local research only, never push)
resaerchBOOKS/
reaserch/

# Derived catalog is optional to commit; keep local by default
data/events/*.jsonl
!data/events/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Claude Code per-project state
.claude/

# Build metadata
*.egg-info/
